<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pnp_solve</name>
  <version>0.1.0</version>
  <description>Estimate target positions and publish them in the robot FLU frame.</description>
  <maintainer email="maintainers@example.com">vo2 contributors</maintainer>
  <license>LicenseRef-Unknown</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>msg_interface</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>target_detection</exec_depend>
  <exec_depend>r2_mission</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
