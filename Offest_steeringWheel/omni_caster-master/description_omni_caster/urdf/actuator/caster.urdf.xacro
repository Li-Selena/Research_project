<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:include filename="$(find description_omni_caster)/urdf/common_inertia.xacro" />
    <xacro:macro name="caster_xacro" params="wheel_name  wheel_radius wheel_length steering_radius steering_length chassis_length offset steering_x steering_y  ">


        <link name="${wheel_name}_steering_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${steering_length}" radius="${steering_radius}" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${steering_length}" radius="${steering_radius}" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.6 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.1" h="${steering_length}" r="${steering_radius}"/>
        </link>       
        <gazebo reference="${wheel_name}_steering_link">
            <mu1 value="20.0" />
            <mu2 value="20.0" />
            <kp value="1000000000.0" />
            <kd value="1.0" />
        </gazebo>
        <joint name="${wheel_name}_steering_joint" type="continuous">
            <parent link="base_link" />
            <child link="${wheel_name}_steering_link" />
            <origin xyz="${steering_x} ${steering_y} ${-1.0*steering_length/2.0-chassis_length/2.0}"  rpy="0 0 1.5708" />
            <axis xyz="0 0 1" />
        </joint>




        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder length="${wheel_length}" radius="${wheel_radius}" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder length="${wheel_length}" radius="${wheel_radius}" />
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.1" h="${wheel_length}" r="${wheel_radius}"/>
        </link>
        <gazebo reference="${wheel_name}_wheel_link">
            <mu1 value="20.0" />
            <mu2 value="20.0" />
            <kp value="1000000000.0" />
            <kd value="1.0" />
        </gazebo>

        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="${wheel_name}_steering_link"/>
            <child link="${wheel_name}_wheel_link" />
            <origin xyz="${-1.0*offset} 0 ${-1.0*steering_length/2.0-wheel_radius-0.001}" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>
</robot>
