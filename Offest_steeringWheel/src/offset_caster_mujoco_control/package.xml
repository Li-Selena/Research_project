<?xml version="1.0"?>
<package format="3">
  <name>offset_caster_mujoco_control</name>
  <version>0.1.0</version>
  <description>ROS 2 control and kinematics for the four powered-caster MuJoCo model.</description>

  <maintainer email="maintainer@example.com">Offset Caster Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>offset_caster_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>offset_caster_dashboard</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
